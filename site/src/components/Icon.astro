---
export type IconName =
  | "web" | "mobile" | "hosting" | "seo" | "video" | "consulting" | "photography"
  | "trending-up" | "landmark" | "spark" | "layers" | "bag" | "cap" | "broadcast"
  | "golf" | "volleyball";

interface Props {
  name: IconName;
}
const { name } = Astro.props;
---
{name === "web" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="4" width="18" height="16" rx="2"/>
    <line x1="3" y1="8.5" x2="21" y2="8.5"/>
    <circle cx="6" cy="6.25" r="0.6" fill="currentColor" stroke="none"/>
    <circle cx="8.2" cy="6.25" r="0.6" fill="currentColor" stroke="none"/>
    <polyline points="9,13 7,15 9,17"/>
    <polyline points="15,13 17,15 15,17"/>
  </svg>
)}
{name === "mobile" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="7" y="2" width="10" height="20" rx="2"/>
    <line x1="10.5" y1="18.2" x2="13.5" y2="18.2"/>
  </svg>
)}
{name === "hosting" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="4" y="4" width="16" height="6" rx="1.2"/>
    <rect x="4" y="14" width="16" height="6" rx="1.2"/>
    <circle cx="8" cy="7" r="0.6" fill="currentColor" stroke="none"/>
    <circle cx="8" cy="17" r="0.6" fill="currentColor" stroke="none"/>
  </svg>
)}
{name === "seo" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="10" cy="10" r="6"/>
    <line x1="14.5" y1="14.5" x2="21" y2="21"/>
    <polyline points="6.5,11.5 8.5,8.5 10.5,10 13,6.5"/>
  </svg>
)}
{name === "video" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="8" width="14" height="12" rx="1.2"/>
    <polygon points="17,11.5 21,9 21,17 17,14.5"/>
    <line x1="6" y1="8" x2="8" y2="4.5"/>
    <line x1="10.5" y1="8" x2="12.5" y2="4.5"/>
  </svg>
)}
{name === "consulting" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="8" width="18" height="12" rx="2"/>
    <path d="M9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>
    <line x1="3" y1="13.5" x2="21" y2="13.5"/>
  </svg>
)}
{name === "photography" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="7" width="18" height="13" rx="2"/>
    <polygon points="9,7 10.3,4.7 13.7,4.7 15,7"/>
    <circle cx="12" cy="13.5" r="3.4"/>
  </svg>
)}
{name === "trending-up" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="3,17 9,11 13,15 21,5"/>
    <polyline points="15,5 21,5 21,11"/>
  </svg>
)}
{name === "landmark" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <polygon points="12,3 21,9 3,9"/>
    <line x1="5" y1="9" x2="5" y2="18"/>
    <line x1="9.5" y1="9" x2="9.5" y2="18"/>
    <line x1="14.5" y1="9" x2="14.5" y2="18"/>
    <line x1="19" y1="9" x2="19" y2="18"/>
    <line x1="3" y1="21" x2="21" y2="21"/>
  </svg>
)}
{name === "spark" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="10" r="5"/>
    <line x1="12" y1="17" x2="12" y2="20"/>
    <line x1="9" y1="20" x2="15" y2="20"/>
  </svg>
)}
{name === "layers" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="3,7 12,3 21,7"/>
    <polyline points="3,12 12,8 21,12"/>
    <polyline points="3,17 12,13 21,17"/>
  </svg>
)}
{name === "bag" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 8h12l-1 12H7L6 8z"/>
    <path d="M9 8V6a3 3 0 0 1 6 0v2"/>
  </svg>
)}
{name === "cap" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <polygon points="12,4 22,9 12,14 2,9"/>
    <path d="M7 11v4.5c0 1.5 2.5 3 5 3s5-1.5 5-3V11"/>
  </svg>
)}
{name === "broadcast" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="1.8" fill="currentColor" stroke="none"/>
    <path d="M8.8 9a5 5 0 0 0 0 6"/>
    <path d="M15.2 9a5 5 0 0 1 0 6"/>
    <path d="M6 6.3a9 9 0 0 0 0 11.4"/>
    <path d="M18 6.3a9 9 0 0 1 0 11.4"/>
  </svg>
)}
{name === "golf" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <line x1="7" y1="21" x2="7" y2="3"/>
    <path d="M7 3.5l8 3.2L7 9.8"/>
    <circle cx="16.5" cy="19" r="2"/>
  </svg>
)}
{name === "volleyball" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="9"/>
    <path d="M12 3c3 3 3 15 0 18"/>
    <path d="M4.5 7.5c4 2.2 11 2.2 15 0"/>
    <path d="M4.5 16.5c4 -2.2 11 -2.2 15 0"/>
  </svg>
)}

<style>
  svg { width: 100%; height: 100%; }
</style>
