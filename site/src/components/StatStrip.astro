---
import { site } from "../data/site";
---
<div class="stat-strip">
  {site.stats.map((s) => (
    <div class="stat-strip__item">
      <span class:list={["stat-strip__value", { "stat-strip__value--sm": s.value.length > 5 }]}>{s.value}</span>
      <span class="stat-strip__label">{s.label}</span>
    </div>
  ))}
</div>
