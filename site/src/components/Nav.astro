---
import { site } from "../data/site";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/experience", label: "Experience" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/services", label: "Services" },
  { href: "/contact", label: "Contact" },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <div class="site-header__top">
      <a href="/" class="site-header__brand">
        <img src="/images/site/logo.png" alt={site.displayName} class="site-header__logo" />
      </a>
      <button type="button" class="site-header__toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <nav class="site-header__nav" id="site-nav">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={["site-header__link", { "is-active": path === item.href }]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector(".site-header__toggle");
  const nav = document.getElementById("site-nav");
  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
  });
  nav?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => {
      nav.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .site-header__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
  }
  .site-header__top {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
  .site-header__brand {
    display: flex;
    align-items: center;
  }
  .site-header__brand:hover { text-decoration: none; }
  .site-header__logo {
    height: 60px;
    width: auto;
    display: block;
  }
  .site-header__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 0;
    height: 32px;
    flex-shrink: 0;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    overflow: hidden;
    opacity: 0;
  }
  .site-header__toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--ink);
    transition: transform 0.2s, opacity 0.2s;
  }
  .site-header__toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .site-header__toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .site-header__toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .site-header__nav {
    display: flex;
    justify-content: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }
  .site-header__link {
    color: var(--ink-soft);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .site-header__link:hover { color: var(--accent); text-decoration: none; }
  .site-header__link.is-active { color: var(--accent); }

  @media (max-width: 700px) {
    .site-header__inner { align-items: stretch; gap: 0; }
    .site-header__top { justify-content: space-between; }
    .site-header__logo { height: 52px; }
    .site-header__toggle { width: 32px; opacity: 1; overflow: visible; }
    .site-header__nav {
      display: none;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      gap: 1rem;
      margin-top: 1.1rem;
    }
    .site-header__nav.is-open { display: flex; }
  }
</style>
